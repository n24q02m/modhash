# Text files are stored with LF and checked out with LF, on every platform.
#
# This is not a style preference. The repository will hold conformance vectors
# and fuzz corpus files whose SHA-256 is quoted in the specifications and in
# CI. If a contributor on Windows checks them out with CRLF, those checksums
# stop matching and a vector file silently becomes a different file.
* text=auto eol=lf

# Conformance vectors, corpus and any other file whose bytes are a contract.
fuzz/** binary
lab/datasets/** binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.bmp binary
*.mp3 binary
*.mp4 binary
*.m4a binary
*.wav binary
*.pdf binary
*.zip

# The lockfile is generated by cargo and is LF by construction.
Cargo.lock text eol=lf